  doorHinge: {fileID: 1188610272}
  doorOpenAngle: -90
  entryWalkSeconds: 6.777495
  enteringRoom: {fileID: 0}
  enteringRoomSpeed: 0.45
  appearance: {fileID: 7400000, guid: 3437c20af1dad5c449339facbf8a7944, type: 2}
  movement:
  - {fileID: 7400000, guid: 3ff85e7358b5fe241a0b5b190de0b81d, type: 2}
  - {fileID: 7400000, guid: 47b2f4ea2284d614b93368fa08ace992, type: 2}
  - {fileID: 7400000, guid: 1f94c0527199f8344b50f4daae6c2c7f, type: 2}
  - {fileID: 7400000, guid: 05d84955ec3a1df46a2773ebfe43458a, type: 2}
  idle: {fileID: 7400000, guid: 04db77e66b20d9c499582301b803fca4, type: 2}
  movementSpeed: 0.65
  tube: {fileID: 1605404918}
  cardReader: {fileID: 268923298}
  cardLever: {fileID: 1752126584}
  turnDuration: 0.5
  approachDuration: 1.5
  returnDuration: 1.25
  closeupFov: 42
  autoAdvance: 1
  minimumLineDuration: 4
  secondsPerCharacter: 0.075
  lines:
  - Greetings, Operator C!
  - Call me Helpy. I'm here to help ofcourse!
  - Sometimes people get bad punch cards that are somehow <i><color=#B5FFA0>corrupted</color></i>.
  - All you need to do is to detect <i><color=#B5FFA0>corrupted</color></i> punch
    cards.
  - Let me show you!
  closingLines:
  - If a card is not corrupted - put it in the left green button tray
  - If it is corrupted - put in in the right red button tray
  - You just need to analazy its contents by saying to yourself
  - <i>"Does it sound weird?"</i> or <i>"Does it look weird?"</i>
  - Okay, hope you won't need to go outside! Goodbye!
