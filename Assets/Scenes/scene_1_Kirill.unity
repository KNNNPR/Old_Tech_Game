--- !u!114 &1863480616
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1863480614}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b76a01cb8837443da87763d908bbb7ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HelpyReturnDialogue
  playerCamera: {fileID: 1109477480}
  player: {fileID: 515159297}
  interactor: {fileID: 515159296}
  playerHUD: {fileID: 1434959141}
  robot: {fileID: 1574143078}
  landingPose: {fileID: 1858939715}
  face: {fileID: 1574143080}
  faceNormal: {x: 0, y: -1, z: 0}
  appearance: {fileID: 7400000, guid: 3437c20af1dad5c449339facbf8a7944, type: 2}
  idle: {fileID: 7400000, guid: 04db77e66b20d9c499582301b803fca4, type: 2}
  subtitleFont: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  turnDuration: 0.55
  approachDuration: 1.5
  returnDuration: 1.25
  closeupFov: 42
  secondsPerCharacter: 0.075
  minimumLineDuration: 4
  autoAdvance: 1
  lines:
  - speaker: 0
    text: Hello again, Operator! How's it going?
  - speaker: 1
    text: Helpy, what these cards are even <b><i><color=#B5FFA0>about</color></i></b>?
      It kind of creeps me out
  - speaker: 0
    text: No worries! They can't harm you, despite the <i><color=#B5FFA0>corrupted</color></i>
      down there
  - speaker: 1
    text: D-Down WHAT?
  - speaker: 0
    text: Well the people that consumed the <i><color=#B5FFA0>corruption</color></i>
      info got...  <b><i><color=#B5FFA0>Mesmerized</color></i></b>
  - speaker: 0
    text: That's why you are <i><color=#B5FFA0>sorting</color></i> them right here
  - speaker: 1
    text: . . .
  - speaker: 0
    text: You didn't read the <b><i><color=#B5FFA0>fine print</color></i></b>, did
      you?
  - speaker: 0
    text: Jokes on you then! Well, bye Operator C
